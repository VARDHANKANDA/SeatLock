# Copy to .env and replace the placeholder values. Never commit .env.

# PostgreSQL (used by docker compose)
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=replace-with-a-strong-password

# JWT signing key: at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION=1h

# Comma-separated list of allowed browser origins. Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=

# "dev" seeds demo accounts and sample data. Leave empty for any shared or production deployment.
SPRING_PROFILES_ACTIVE=dev

# Reservation holds, cache and background workers (defaults shown)
RESERVATION_HOLD_DURATION_SECONDS=300
EVENT_CACHE_TTL_SECONDS=60
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=50

# Longest a booking or hold waits for a database row lock before failing with 503 (0 disables)
LOCK_TIMEOUT_MS=3000

# Retention of finished rows (0 disables a rule; pending outbox events are never deleted)
OUTBOX_RETENTION_DAYS=14
OUTBOX_FAILED_RETENTION_DAYS=0
IDEMPOTENCY_RETENTION_HOURS=24

# Only behind a reverse proxy you control: FORWARD_HEADERS_STRATEGY=native and TRUSTED_PROXIES set to a regex
# matching the proxy's address, e.g. TRUSTED_PROXIES=10\.0\.0\.\d+. Leave both unset when clients connect directly.
FORWARD_HEADERS_STRATEGY=none
TRUSTED_PROXIES=

# Rate limits per minute: login and registration per client IP, booking and hold creation per user
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5
BOOKING_RATE_LIMIT_PER_MINUTE=30

# Host ports (bound to 127.0.0.1)
APP_PORT=8080
DB_PORT=15432
REDIS_HOST_PORT=16379
